<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dados_titulo"
            android:textAppearance="@style/Painel.Titulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dados_ajuda"
            android:textAppearance="@style/Painel.Corpo" />

        <!-- Cópia de segurança -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/copia_seguranca"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <TextView
                    android:id="@+id/tvResumoDados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Painel.Corpo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/exportar" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/exportar_ajuda"
                    android:textAppearance="@style/Painel.Corpo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Importar -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/importar_titulo"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/importar_pergunta"
                    android:textAppearance="@style/Painel.Corpo" />

                <RadioGroup
                    android:id="@+id/grupoModo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbJuntar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/modo_juntar" />

                    <RadioButton
                        android:id="@+id/rbSubstituir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/modo_substituir" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/importar_ficheiro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Protocolo -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protocolo_titulo"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <TextView
                    android:id="@+id/tvProtocolo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Painel.Corpo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportarProtocolo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/importar_parametros" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReporProtocolo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/repor_parametros"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Outras opções -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/outras_opcoes"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExemplo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/carregar_exemplo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApagar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apagar_tudo"
                    android:textColor="@color/negativo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
