<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Painel.Titulo" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Painel.Corpo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/desc_mes_anterior"
                android:text="@string/mes_anterior" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscolherMes"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1.4"
                android:contentDescription="@string/escolher_mes"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeguinte"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/desc_mes_seguinte"
                android:text="@string/mes_seguinte" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHoje"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voltar_a_este_mes"
            android:visibility="gone" />

        <!-- Receita -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPerguntaReceita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReceita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/receita"
                    app:suffixText="€">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReceita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="numberDecimal"
                        android:textSize="24sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarReceita"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guardar_receita"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mês já investido -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInvestido"
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/menta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvInvestidoTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Painel.Subtitulo"
                    android:textColor="@color/primaria" />

                <TextView
                    android:id="@+id/tvInvestidoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Painel.Corpo"
                    android:textColor="@color/tinta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnular"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/anular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Para onde vai o dinheiro -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDivisao"
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/para_onde_vai"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <LinearLayout
                    android:id="@+id/barraDivisao"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginVertical="12dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/listaDivisao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Onde investir -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInvestir"
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOndeInvestir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/onde_investir_ajuda"
                    android:textAppearance="@style/Painel.Corpo" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDestinos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <CheckBox
                    android:id="@+id/cbSomar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/somar_aos_totais" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInvestir"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/ja_investi"
                    android:textSize="18sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSemInvestimento"
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sem_investimento_titulo"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sem_investimento_texto"
                    android:textAppearance="@style/Painel.Corpo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Avisos -->
        <LinearLayout
            android:id="@+id/listaAvisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Histórico -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHistorico"
            style="@style/Painel.Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/meses_registados"
                    android:textAppearance="@style/Painel.Subtitulo" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
